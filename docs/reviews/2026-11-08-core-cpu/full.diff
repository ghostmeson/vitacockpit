+void platform_read_cpu(PlatformCpu *out)
+{
+    if (out == NULL)
+        return;
+
+    memset(out, 0, sizeof(*out));
+
+    /*
+     * [V] psp2/kernel/threadmgr/thread.h: the userland SceLibKernel export
+     * populates per-CPU idle clocks, wakeup counts, and thread-switch counts.
+     * `size` must be set first.
+     *
+     * [C] `idleClock` is assumed to be microseconds. This is the unit PSVshell
+     * divides by its microsecond process tick; the header does not state it.
+     * core/metrics.c rejects a sample whose idle delta exceeds the elapsed
+     * time, so a wrong unit becomes "--", never a percentage.
+     */
+    SceKernelSystemInfo info;
+    memset(&info, 0, sizeof(info));
+    info.size = sizeof(info);
+
+    if (sceKernelGetSystemInfo(&info) < 0)
+        return;
+    if (info.activeCpuMask == 0)
+        return;
+
+    uint64_t time_us = sceKernelGetProcessTimeWide();
+    if (time_us == 0)
+        return;
+
+    int have_idle = 0;
+
+    out->time_us = time_us;
+    out->active_mask = info.activeCpuMask;
+
+    for (int i = 0; i < PLATFORM_CPU_COUNT; ++i) {
+        out->idle_us[i] = info.cpuInfo[i].idleClock;
+
+        if ((info.activeCpuMask & (1u << i)) == 0)
+            continue;
+
+        out->ctx_switches += info.cpuInfo[i].threadSwitchCount;
+        out->wakeups += info.cpuInfo[i].comesOutOfIdleCount;
+
+        if (out->idle_us[i] > 0)
+            have_idle = 1;
+    }
+
+    /*
+     * A zero idle clock on every active core is not a real 100 % load; it is a
+     * counter that has not started yet. Refuse the sample and let the next
+     * 100 ms window establish the baseline.
+     */
+    if (!have_idle)
+        return;
+
+    out->ok = 1;
+}
