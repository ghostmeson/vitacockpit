# macOS
.DS_Store

# ---------------------------------------------------------------------------
# Build output
#
# build.sh regenerates build/ from scratch and keeps exactly one VPK there.
# BUILD_NUMBER lives beside this file on purpose: wiping build/ must not reuse
# a build number that is already on the console.
# ---------------------------------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
.source-stamp

# Vita artifacts, wherever they land
*.vpk
*.vpk.out
*.velf
*.self
*.self.out
*.skprx
*.suprx
*.elf
*.a

# ---------------------------------------------------------------------------
# Console data
#
# A .psp2dmp is a full copy of console process memory, including mapped system
# modules. It is analysis input, never source. The GPU study in
# docs/gpu-crash-study/ keeps its ANALYSIS.md; the dumps stay local.
#
# user-files/ holds a console's own tai/tai config for local reference. Do not
# publish a machine's config by accident.
# ---------------------------------------------------------------------------
*.psp2dmp
*.psp2dmp.tmp
*.tmp
user-files/

# ---------------------------------------------------------------------------
# Third-party tools cloned for a study
# ---------------------------------------------------------------------------
tools/psp2_gpucrash_parse/

# Editors
.vscode/
.idea/
